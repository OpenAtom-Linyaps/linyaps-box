# SPDX-License-Identifier: CC0-1.0

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,c,h,cc,cxx,hxx}]
indent_style = space
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[{*.sh,ll-box-st}]
indent_style = space
indent_size = 2
switch_case_indent = true
space_redirects = true

[*.md]
trim_trailing_whitespace = false
indent_size = 4
